# Copia este fichero a .env (sin extension) junto a docker-compose.yml
# EN EL SERVIDOR, y rellena los cuatro valores.
#
# El .env esta en .gitignore: nunca lo subas a ningun sitio.

# Tu subdominio, por ejemplo el gratuito de duckdns.org
VAULT_DOMAIN=cambiame.duckdns.org

# Contrase~na del panel. Generala larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_AUTH_TOKEN=pon-aqui-una-contrasena-larga-y-aleatoria

# Credenciales de tu aplicacion de Twitch (dev.twitch.tv/console/apps).
# El nombre de la aplicacion no puede contener la palabra "Twitch".
VAULT_CLIENT_ID=tu-client-id
VAULT_CLIENT_SECRET=tu-client-secret

# La retencion y la frecuencia de sondeo se ajustan desde el panel, no aqui.
